#!/usr/bin/env bash
# bersihkan - Pembersih project: hapus node_modules, build output, cache framework secara rekursif
# Usage: bersihkan [PATH] [OPTIONS]
#   PATH default: . (current folder)
#   Bisa dipanggil dari mana pun, akan scan rekursif dari PATH tersebut.

set -e

# ---- warna ----
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

TARGET="."
DRY_RUN=false
INCLUDE_VENDOR=false
VERBOSE=false

usage() {
  cat <<'EOF'
Usage: bersihkan [PATH] [OPTIONS]

  PATH         Folder target (default: current folder ".")
               Scan dilakukan REKURSIF dari PATH tersebut.

OPTIONS:
  -n, --dry-run    Hanya tampilkan apa yang akan dihapus (tidak menghapus)
  -v, --verbose    Tampilkan detail
      --vendor     Juga hapus vendor/ (PHP/Laravel) & pnpm-lock bloat
  -h, --help       Tampilkan bantuan ini
  -y, --yes        Langsung hapus tanpa konfirmasi

Contoh:
  bersihkan                  # bersihkan folder ini secara rekursif
  bersihkan ~/Projects       # bersihkan semua project di ~/Projects
  bersihkan . --dry-run      # cek dulu apa yang akan dihapus
  bersihkan . --vendor -y    # hapus termasuk vendor/ tanpa tanya

Yang dihapus (rekursif, semua ditemukan akan dihapus):
  JS/Node/React/Next/Nuxt/Astro/Vite:
    node_modules, .next, .nuxt, .output, .vercel, .turbo, out, dist, build,
    .parcel-cache, .vite, coverage, .nyc_output, .cache

  Laravel/PHP:
    bootstrap/cache/*.php, storage/framework/views/*,
    storage/framework/cache/*, storage/framework/sessions/*,
    storage/logs/*.log   (+ vendor/ jika --vendor)

  Python: __pycache__, .pytest_cache, .mypy_cache, .ruff_cache
  Umum: .DS_Store, *.log
EOF
}

# ---- parse args ----
AUTO_YES=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -n|--dry-run) DRY_RUN=true; shift ;;
    -v|--verbose) VERBOSE=true; shift ;;
    --vendor) INCLUDE_VENDOR=true; shift ;;
    -y|--yes) AUTO_YES=true; shift ;;
    --) shift; break ;;
    -*) echo -e "${RED}Unknown option: $1${NC}"; usage; exit 1 ;;
    *) TARGET="$1"; shift ;;
  esac
done

if [[ ! -d "$TARGET" ]]; then
  echo -e "${RED}✗ Folder tidak ditemukan: $TARGET${NC}"
  exit 1
fi

TARGET="$(cd "$TARGET" && pwd)"

echo -e "${CYAN}🧹 bersihkan${NC} ${DIM}→ $TARGET${NC}"
if $DRY_RUN; then echo -e "${YELLOW}  [DRY-RUN] tidak ada yang benar-benar dihapus${NC}"; fi
echo ""

# ---- daftar folder/file yang akan dicari (nama exact untuk -type d / -type f) ----
# Dipisah: dir_targets dan file_targets
DIR_TARGETS=(
  "node_modules"
  ".next"
  ".nuxt"
  ".output"
  ".vercel"
  ".turbo"
  "out"
  "dist"
  "build"
  ".parcel-cache"
  ".vite"
  "coverage"
  ".nyc_output"
  ".cache"
  "__pycache__"
  ".pytest_cache"
  ".mypy_cache"
  ".ruff_cache"
)

FILE_TARGETS=(
  ".DS_Store"
)

# Laravel file targets (hapus isinya, bukan foldernya biar tidak error permission)
LARAVEL_CACHE_GLOBS=(
  "bootstrap/cache/*.php"
  "storage/framework/views/*"
  "storage/framework/cache/data/*"
  "storage/framework/sessions/*"
  "storage/logs/*.log"
)

if $INCLUDE_VENDOR; then
  DIR_TARGETS+=("vendor")
fi

FOUND=()
TOTAL_SIZE=0

# Helper: cari dengan find, prune biar tidak masuk ke node_modules yang sudah ketemu (lebih cepat)
find_dirs() {
  local name="$1"
  # -prune tidak dipakai di sini karena kita tetap mau hapus semua, tapi kita cari semua level
  find "$TARGET" -type d -name "$name" -prune -print 2>/dev/null || true
}

# Kumpulkan direktori
echo -e "${DIM}Mencari...${NC}"
for d in "${DIR_TARGETS[@]}"; do
  while IFS= read -r p; do
    [[ -n "$p" ]] && FOUND+=("$p")
  done < <(find "$TARGET" -type d -name "$d" 2>/dev/null)
done

# Kumpulkan file .DS_Store dll
for f in "${FILE_TARGETS[@]}"; do
  while IFS= read -r p; do
    [[ -n "$p" ]] && FOUND+=("$p")
  done < <(find "$TARGET" -type f -name "$f" 2>/dev/null)
done

# Laravel cache files (glob-like)
for pat in "${LARAVEL_CACHE_GLOBS[@]}"; do
  # pat seperti "bootstrap/cache/*.php" -> cari file di TARGET/**/bootstrap/cache
  dir_part="$(dirname "$pat")"
  file_pat="$(basename "$pat")"
  while IFS= read -r p; do
    [[ -n "$p" ]] && FOUND+=("$p")
  done < <(find "$TARGET" -path "*/$dir_part/$file_pat" -type f 2>/dev/null)
  # juga handle "data/*" yang nested
  if [[ "$file_pat" == "*" ]]; then
    while IFS= read -r p; do
      [[ -n "$p" ]] && FOUND+=("$p")
    done < <(find "$TARGET" -path "*/$dir_part/*" -type f 2>/dev/null | head -n 200)
  fi
done

# Unique + sort
if [[ ${#FOUND[@]} -eq 0 ]]; then
  echo -e "${GREEN}✨ Sudah bersih! Tidak ada yang perlu dihapus.${NC}"
  exit 0
fi

# Dedup (compatible bash 3.2 macOS)
DEDUPED=()
while IFS= read -r line; do
  [[ -n "$line" ]] && DEDUPED+=("$line")
done < <(printf "%s\n" "${FOUND[@]}" | sort -u)
FOUND=("${DEDUPED[@]}")
unset DEDUPED

# Hitung ukuran
echo -e "${YELLOW}Ditemukan ${#FOUND[@]} item:${NC}"
echo ""
for p in "${FOUND[@]}"; do
  if $VERBOSE || $DRY_RUN; then
    size=$(du -sh "$p" 2>/dev/null | cut -f1)
    printf "  ${DIM}%-8s${NC} %s\n" "$size" "${p#$TARGET/}"
    # fallback jika du gagal
    if [[ -z "$size" ]]; then
      printf "  %s\n" "${p#$TARGET/}"
    fi
  else
    echo "  • ${p#$TARGET/}"
  fi
done

# Total size
TOTAL=$(du -shc "${FOUND[@]}" 2>/dev/null | tail -1 | cut -f1)
echo ""
echo -e "  ${CYAN}Total: $TOTAL${NC}  ${DIM}(${#FOUND[@]} item)${NC}"
echo ""

if $DRY_RUN; then
  echo -e "${YELLOW}Dry-run selesai. Jalankan tanpa --dry-run untuk menghapus.${NC}"
  exit 0
fi

if ! $AUTO_YES; then
  echo -ne "${YELLOW}Hapus semua di atas? [y/N] ${NC}"
  read -r ans
  case "$ans" in
    y|Y|yes|YES) ;;
    *) echo "Dibatalkan."; exit 0 ;;
  esac
fi

echo ""
FAILED=0
DELETED=0
for p in "${FOUND[@]}"; do
  if rm -rf "$p" 2>/dev/null; then
    echo -e "${GREEN}  ✓${NC} ${p#$TARGET/}"
    DELETED=$((DELETED+1))
  else
    echo -e "${RED}  ✗ Gagal: ${p}${NC}"
    FAILED=$((FAILED+1))
  fi
done

echo ""
if [[ $FAILED -eq 0 ]]; then
  echo -e "${GREEN}✨ Selesai! $DELETED item dibersihkan ($TOTAL dibebaskan)${NC}"
else
  echo -e "${YELLOW}Selesai dengan $FAILED gagal, $DELETED berhasil.${NC}"
fi
# Bersihkan juga lock file sampah Next/Turbo jika ada
# (opsional, tidak error jika tidak ada)
